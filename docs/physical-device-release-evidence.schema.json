{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical-device-release-evidence.schema.json",
  "title": "CAT5 physical-device release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "reviewedCandidateSha",
    "releaseTag",
    "version",
    "distSha256",
    "archive",
    "completedAt",
    "operator",
    "environments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "status": {
      "enum": ["PASS", "FAIL", "NOT RUN", "PARTIAL"]
    },
    "reviewedCandidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-beta\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-beta\\.[0-9]+$"
    },
    "distSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^chat-nocontrol-v[0-9]+\\.[0-9]+\\.[0-9]+-beta\\.[0-9]+\\.tgz$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "signingIdentity"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "signingIdentity": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._%+@-]{3,254}$"
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "mode",
          "browser",
          "deviceModel",
          "osVersion",
          "browserVersion",
          "completedAt",
          "checks"
        ],
        "properties": {
          "id": {
            "enum": [
              "android-chrome",
              "android-installed-pwa",
              "iphone-safari",
              "iphone-home-screen"
            ]
          },
          "platform": {
            "enum": ["android", "ios"]
          },
          "mode": {
            "enum": ["browser", "installed-pwa", "home-screen"]
          },
          "browser": {
            "enum": ["Chrome", "Safari"]
          },
          "deviceModel": {
            "type": "string",
            "minLength": 1
          },
          "osVersion": {
            "type": "string",
            "minLength": 1
          },
          "browserVersion": {
            "type": "string",
            "minLength": 1
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "array",
            "minItems": 15,
            "maxItems": 15,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "notes"],
              "properties": {
                "id": {
                  "enum": [
                    "cat5-identity",
                    "cat5-recovery",
                    "cat5-text",
                    "cat5-files",
                    "cat5-contacts",
                    "cat5-links",
                    "recovery-qr-camera",
                    "recovery-qr-image-import",
                    "legacy-ppxt",
                    "legacy-ppxf",
                    "legacy-ppxq",
                    "legacy-archived-camera-link",
                    "offline-reopen",
                    "silent-upgrade",
                    "web-share"
                  ]
                },
                "status": {
                  "enum": ["PASS", "FAIL", "NOT RUN", "NOT SUPPORTED"]
                },
                "supported": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
